# Modelo do que colar na tela de "Secrets" do Streamlit Community Cloud
# (App settings -> Secrets), ou salvar como .streamlit/secrets.toml pra rodar local.
# NUNCA commitar o arquivo real - só este exemplo, sem senha de verdade.

[usuarios."luiz.amo@callmedsaude.com.br"]
nome = "Luiz Amo"
papel = "master"
senha = "troque-esta-senha"

# Adicione o gestor e o analista no mesmo formato quando tiver os dados deles:
# [usuarios."email-do-gestor@callmedsaude.com.br"]
# nome = "Nome do Gestor"
# papel = "gestor"
# senha = "outra-senha"
#
# [usuarios."email-do-analista@callmedsaude.com.br"]
# nome = "Nome do Analista"
# papel = "analista"
# senha = "mais-outra-senha"

# Credenciais do Supabase (projeto "callmed-premium-plantoes") - onde vive a base de plantões e
# o mapeamento Apoio desde 2026-08-20. Pegue em supabase.com/dashboard/project/_/settings/api.
[supabase]
url = "https://SEU-PROJETO.supabase.co"
key = "sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX"
